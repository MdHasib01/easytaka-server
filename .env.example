NODE_ENV=development
PORT=5000

MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>/easytaka?retryWrites=true&w=majority"

# At least 32 characters
JWT_SECRET="change-me-to-a-long-random-string-of-64-chars"
JWT_EXPIRES_IN="7d"

# Comma-separated list of allowed browser origins
CORS_ORIGIN="http://localhost:3000,http://localhost:5173"
# SMM self-registration. Also needs Cloudinary (below): NID photos are stored as private assets.
ALLOW_PUBLIC_REGISTER=true

# Demo endpoints (/api/demo/*) used by the client's Demo Controls panel. Off by default
# because /api/demo/reset wipes and re-seeds the database. Never enable on real data.
# DEMO_MODE=true

# Encrypts stored social-account passwords. If unset, a key is derived from JWT_SECRET
# (rotating JWT_SECRET would then make stored passwords unreadable).
# CREDENTIALS_ENCRYPTION_KEY="another-long-random-string"

# Business timezone offset in minutes for daily/weekly periods (Asia/Dhaka = 360)
# TZ_OFFSET_MINUTES=360

# Set to the number of proxy hops when running behind a load balancer (for rate limiting)
# TRUST_PROXY=1

SEED_ADMIN_PASSWORD="pass123"
SEED_SMM_PASSWORD="pass123"

CLOUDINARY_URL="cloudinary://<api_key>:<api_secret>@<cloud_name>"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
